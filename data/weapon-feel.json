{
  "_note": "How firing and reloading should FEEL (docs/gdd/09). Reload beats are fractions of the weapon's reload time (perShell: of each shell's time), in order; each beat is a pose the model and arm must hit, with a sound cue. Fire feel per weapon class: kick = camera pitch kick in degrees per shot, shake = screen shake 0-1, push = how far the gun body recoils back in metres, settle = seconds to return, flash = muzzle bloom size in metres (organic spray, not a star). Gameplay and Creature read these; tune here.",
  "reload": {
    "magazine": {
      "beats": [
        {
          "at": 0.0,
          "pose": "arm tilts, spent sac twitches",
          "cue": "wet squelch"
        },
        {
          "at": 0.2,
          "pose": "host tears the spent sac free; it falls and twitches on the ground for 2 s",
          "cue": "rip"
        },
        {
          "at": 0.5,
          "pose": "fresh sac pressed in; feed tentacles grab it",
          "cue": "suck"
        },
        {
          "at": 0.8,
          "pose": "gun shudders, eyes reopen, ready",
          "cue": "click of chitin"
        }
      ],
      "emptyExtraPose": "host slaps the gun's flank to wake it"
    },
    "perShell": {
      "beats": [
        {
          "at": 0.0,
          "pose": "throat/cylinder opens",
          "cue": "jaw creak"
        },
        {
          "at": 0.4,
          "pose": "one shell pushed in by thumb",
          "cue": "gulp"
        },
        {
          "at": 0.9,
          "pose": "throat closes round it",
          "cue": "soft clack"
        }
      ],
      "cancelAt": 0.9,
      "openAndCloseTime": 0.25
    },
    "regrow": {
      "beats": [
        {
          "at": 0.0,
          "pose": "gun curls inward, eyes close",
          "cue": "low hum"
        },
        {
          "at": 0.5,
          "pose": "new tissue swells visibly along the body, glow builds in pulses",
          "cue": "heartbeat"
        },
        {
          "at": 0.95,
          "pose": "gun uncurls and flexes",
          "cue": "exhale"
        }
      ]
    }
  },
  "fire": {
