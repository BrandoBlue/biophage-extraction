{
  "name": "biophage-extraction",
  "version": "0.2.0",
  "description": "BIOPHAGE: EXTRACTION, a bio-cybernetic PvPvE extraction shooter",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "smoke": "node tests/smoke.mjs",
    "lookdev": "node tests/lookdev.mjs",
    "lookdev:player": "node tests/playerview.mjs",
    "check": "npm run release && npm test && npm run smoke && npm run smoke:release && npm run budget && npm run smoke:raid && npm run smoke:creatures && npm run smoke:raid:release",
    "release": "npm run build && node scripts/bundle-single.mjs",
    "smoke:release": "node tests/smoke.mjs --release",
    "budget": "node tests/budget.mjs",
    "smoke:raid": "node tests/raid.mjs",
    "smoke:raid:release": "node tests/raid.mjs --release",
    "mocks": "node tests/ui-mocks.mjs",
    "smoke:creatures": "node tests/creatures.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrandoBlue/biophage-extraction.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/BrandoBlue/biophage-extraction/issues"
  },
  "homepage": "https://github.com/BrandoBlue/biophage-extraction#readme",
  "devDependencies": {
    "@types/three": "^0.187.0",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "three": "^0.187.0"
  },
  "private": true,
  "type": "module"
}
